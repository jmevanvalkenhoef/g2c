# /etc/g2c/env — root-only (chmod 600). Fill and install before enabling units.
# shared game<->escrow secret (generate: openssl rand -hex 24)
ESCROW_SHARED_SECRET=
# escrow
NODE_BACKEND=lnd
LND_REST_URL=https://localhost:8080
LND_TLS_CERT=/root/.lnd/tls.cert
LND_MACAROON=/root/.lnd/data/chain/bitcoin/mainnet/admin.macaroon
GAME_URL=http://127.0.0.1:8200
FEE_MSAT=1000
DEMO_BRIDGE=0
DB_PATH=/var/lib/g2c/escrow/escrow.db
# game
ESCROW_URL=http://127.0.0.1:8100
PAYOUT_MODE=real
