# /etc/g2c/escrow.env — root-only (chmod 600)
ESCROW_SHARED_SECRET=<openssl rand -hex 24>
NODE_BACKEND=lnd
LND_REST_URL=https://localhost:8080
LND_TLS_CERT=/root/.lnd/tls.cert
LND_MACAROON=/root/.lnd/data/chain/bitcoin/mainnet/admin.macaroon
GAME_URL=http://127.0.0.1:8200
# fee per sale = FEE_MSAT + amount * FEE_PPM / 1e6 (10000 ppm = 1 %).
# PRICING DECISION: the value below is a placeholder, set your own.
FEE_MSAT=1000
FEE_PPM=10000
# routing fee the seller payout may cost; defaults to the sale's fee (a
# sale never costs more than it earns). Raise only deliberately.
#MAX_ROUTING_FEE_MSAT=
# buyer HTLC time budget (blocks) and the margin kept below it
HOLD_CLTV_EXPIRY=288
HOLD_SAFETY_BLOCKS=24
MIN_PAYOUT_CLTV=60
DEMO_BRIDGE=0
DB_PATH=/var/lib/g2c/escrow/escrow.db
# operator API: one named token per person (name:token, comma separated),
# each at least 32 chars; every admin action is recorded under that name.
# Leave unset to keep the operator API off.
#ADMIN_TOKENS=joost:<openssl rand -hex 24>
